# ====================================================================
# Gitignore rules for Terrain Relative Navigation (TRN) Project
# ====================================================================

# Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Runtime output directories (saves clean code but ignores local runs)
outputs/
**/outputs/
*.png
*.jpg
*.jpeg
report.txt

# Heavy Data Dependencies & Local Models
data/
*.pt
*.weights
best.pt

# IDE / System files
.vscode/
.idea/
.DS_Store
Thumbs.db